# ===========================================================================
# SENTINEL-RS Environment Configuration Example
# Copy this file to .env and adjust variables for your target environment.
# ===========================================================================

# Execution Environment: "local" (default) or "param_shavak"
SENTINEL_ENV=param_shavak

# Project Root (Optional: defaults to repository root)
# SENTINEL_RS_ROOT=/home/user/SENTINEL-RS

# Dataset Roots on Target Machine
# On PARAM SHAVAK Linux Cluster:
S1_DIR=/home/user/data/BigEarthNet-S1-Required
S2_DIR=/home/user/data/BigEarthNet-S2

# Outputs and Artifacts
# Defaults to $SENTINEL_RS_ROOT/param_shavak/results when SENTINEL_ENV=param_shavak
# RESULTS_DIR=/home/user/SENTINEL-RS/param_shavak/results

# Performance & Hardware Overrides
BATCH_SIZE=64
NUM_WORKERS=8
PIN_MEMORY=1

